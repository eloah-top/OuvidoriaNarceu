# Exemplo — copie para .env
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
# Banco (SQLite por padrão; para Supabase/Postgres defina DATABASE_URL)
DB_STORAGE=./data/ouvidoria.sqlite
# DATABASE_URL=postgres://user:pass@host:5432/db
# DATABASE_DIALECT=postgres
# DB_SSL=true
# TURMAS_SEED=1º A,1º B,2º A,2º B
